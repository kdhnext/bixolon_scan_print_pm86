<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScanToPrint" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/bxl_orange</item>
        <item name="colorPrimaryVariant">@color/bxl_orange_tint1</item>
        <item name="colorOnPrimary">@color/bxl_white</item>
        <item name="colorSecondary">@color/bxl_teal</item>
        <item name="colorSecondaryVariant">@color/bxl_teal</item>
        <item name="colorOnSecondary">@color/bxl_white</item>
        <item name="android:windowBackground">@color/bxl_light_gray</item>
        <item name="android:statusBarColor">@color/bxl_orange</item>
        <item name="android:textColor">@color/bxl_dark_gray</item>
    </style>

    <style name="BxlButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="BxlButton.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/btn_secondary_stroke</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="BxlButton.Tonal" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/bxl_dark_gray</item>
        <item name="android:textColor">@color/bxl_white</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/bxl_dark_gray</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="FieldLabel">
        <item name="android:textColor">@color/bxl_gray</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
</resources>
