<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bxl_white"/>
        </shape>
    </item>
    <item android:bottom="0dp" android:left="-40dp" android:right="-40dp" android:top="-40dp">
        <rotate android:fromDegrees="-12" android:pivotX="50%" android:pivotY="100%">
            <shape android:shape="rectangle">
                <solid android:color="#1AEE7203"/>
            </shape>
        </rotate>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="3dp"/>
            <solid android:color="@color/bxl_orange"/>
        </shape>
    </item>
</layer-list>
